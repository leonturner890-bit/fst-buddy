# Copy this file to .env and fill in real values.

# Port the backend listens on. Most hosting platforms set this for you —
# leave it as-is unless you know you need a specific port.
PORT=4317

# Optional. Where the SQLite ledger file lives. Defaults to ./data next
# to this .env file, which is fine for local use and a plain VPS. On a
# platform with a mounted persistent volume (Railway, Fly.io), point this
# at that volume's mount path instead, e.g. DATA_DIR=/data — otherwise
# the usage ledger resets on every restart/redeploy.
DATA_DIR=

# Required for online mode. Get a key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL for a locally running Ollama instance, used in offline mode.
# Install Ollama from https://ollama.com and run e.g. `ollama pull llama3.1`
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Shared secret the desktop app's admin panel must send as
# `Authorization: Bearer <token>` to reach /api/admin/* routes.
ADMIN_TOKEN=change-me-please

# Optional: Stripe keys, only needed if you wire up real subscriptions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: real rewarded-ad network credentials (see services/adVerification.js).
ADMOB_SSV_PUBLIC_KEYS_URL=https://gstatic.com/admob/reward/verifier-keys.json
IRONSOURCE_SECRET_KEY=
APPLOVIN_SECRET_KEY=
